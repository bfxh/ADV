      "txt": "body { margin: 0; font: 16px/1.5 sans-serif; }\n  p { width: 160px; margin: 8px; }\n  /* 1 放得下：不该报 */\n  .fits { }\n  /* 2 单行裁切：overflow:hidden + nowrap，宽度不够 */\n  .clip { overflow: hidden; white-space: nowrap; }\n  /* 3 省略号：同样被裁，但带 text-overflow:ellipsis（设计如此，但也是溢出信号） */\n  .ell { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n  /* 4 纵向裁切：多行 + 固定高度 + overflow:hidden */\n  .vclip { height: 24px; overflow: hidden; }\n  /* 5 多行省略（-webkit-line-clamp） */\n  .clamp { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }"

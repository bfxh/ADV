    {
      "ch": "DomText",
      "loc": "style",
      "rect": {
        "h": 0,
        "w": 0,
        "x": 0,
        "y": 0
      },
      "txt": "/* 1 字面量：computed content 实测回来**不带引号** */\n  .lit::before { content: \"字面量-前\"; }\n  .lit::after  { content: \"字面量-后\"; }\n  /* 2 attr() 引用：实测回来是**已解析**的值 */\n  .attr::before { content: attr(data-tip); }\n  /* 3 多段拼接 */\n  .multi::after { content: \"A\" \" · \" \"B\"; }\n  /* 4 unicode 转义：实测回来是解码后的 纯字 */\n  .esc::before { content: \"\\7eaf\\5b57\"; }\n  /* 5 CSS 自定义属性塞文案：实测回来是已解析值 */\n  .var { --msg: \"变量-文案\"; }\n  .var::after { content: var(--msg); }\n  /* 6 counter：实测回来是**未解析令牌** 'counter(i) \". \"' ⇒ 判据必须丢掉 */\n  ol.cnt { counter-reset: i; }\n  ol.cnt li::before { content: counter(i) \". \"; counter-increment: i; }\n  /* 7 display:none 的宿主：computed content 照样给值 ⇒ 必须按几何过滤，否则误报 */\n  .hide { display: none; }\n  .hide::before { content: \"隐藏-前\"; }\n  /* 8 装饰性空 content（噪音，不该进结果） */\n  .deco::before { content: \"\"; position: absolute; width: 4px; height: 4px; background: #333; }\n  /* 9 ::marker 的 content：实测能读到，而且**带引号**（与 before/after 不对称） */\n  ul.mk li::marker { content: \"标记-\"; }"
    },
